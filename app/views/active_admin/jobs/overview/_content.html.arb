# frozen_string_literal: true

namespace = active_admin_config.namespace
adapter = ActiveAdmin::Jobs.adapter
stats = adapter.stats
queued = namespace.resource_for(ActiveAdmin::Jobs::QueuedJob)
clear = queued && authorized?(ActiveAdmin::Auth::DESTROY, ActiveAdmin::Jobs::QueuedJob)

columns do
  column do
    panel I18n.t("active_admin.jobs.overview.queues") do
      table_for adapter.queues do
        column(:name) do |queue|
          queued ? link_to(queue.name, queued.route_collection_path({}, queue: queue.name)) : queue.name
        end
        column :size
        if clear
          column("") do |queue|
            confirm = I18n.t("active_admin.jobs.queued_jobs.clear_confirmation", queue: queue.name, count: queue.size)
            link_to I18n.t("active_admin.jobs.queued_jobs.clear"),
                    url_for(controller: "/#{queued.controller.controller_path}", action: :clear, queue: queue.name),
                    method: :delete, data: { confirm: }, class: "member_link"
          end
        end
      end
    end
  end

  column do
    if adapter.supports?(:workers)
      working = adapter.workers.select(&:working?)
      panel I18n.t("active_admin.jobs.overview.working", count: working.size) do
        table_for working do
          column(:worker, &:id)
          column :job_queue
          column :job_class
          column :run_at
        end
      end
    end

    panel I18n.t("active_admin.jobs.overview.stats") do
      table_for stats.to_a, class: "job-stats" do
        column(:name) { |name, _| name.to_s.humanize }
        column(:value) { |_, value| value }
      end
    end
  end
end
