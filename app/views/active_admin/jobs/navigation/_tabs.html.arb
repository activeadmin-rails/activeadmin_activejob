# frozen_string_literal: true

tabs = ActiveAdmin::Jobs::Tabs.for(self)
if tabs.size > 1
  nav id: "jobs_tabs" do
    ul do
      tabs.each do |tab|
        li class: [tab.id, ("selected" if tab.current)].compact.join(" ") do
          a href: tab.path, "aria-current": ("page" if tab.current) do
            text_node tab.label
            span tab.badge, class: "count" if tab.badge
          end
        end
      end
    end
  end
end
