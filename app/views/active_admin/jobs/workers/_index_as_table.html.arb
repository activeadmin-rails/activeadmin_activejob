# frozen_string_literal: true

index_table_for(collection, default_table_options) do
  column(:host) { |worker| link_to worker.host, resource_path(worker) }
  column :pid
  column(:queues) { |worker| worker.queues.join(", ") }
  column(:state) { |worker| status_tag worker.state, class: (worker.working? ? "yes" : "no") }
  column :job_class
  column :run_at
  column :processed
  column :failed
  column :started_at
end
